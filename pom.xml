<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.schoste.ddd.application</groupId>
    <artifactId>spring-webmvc-utilities2</artifactId>
    <version>2.0.0.RELEASE</version>
    <name>Spring MVC Web Application Utilities 2</name>
    <description>
        Spring MVC Web Application Utilities 2: the application layer between Spring MVC controllers and the repositories of
        Domain Repository 3 (domain-repository3): data transfer objects (DTOs) and their converters, and an interceptor which
        executes handlers for custom annotations of controllers. Java 8 and later, Spring 5.3, Servlet 4.0 (javax.servlet).
        Documentation: the README of the GitHub repository and the Javadoc jar (start with its overview).
    </description>
    <url>https://github.com/phisch84/spring-webmvc-utilities</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/phisch84/spring-webmvc-utilities/blob/master/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Philipp Schosteritsch</name>
            <email>s.philipp@schoste.com</email>
            <url>https://www.schoste.com/</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/phisch84/spring-webmvc-utilities.git</connection>
        <developerConnection>scm:git:https://github.com/phisch84/spring-webmvc-utilities.git</developerConnection>
        <url>https://github.com/phisch84/spring-webmvc-utilities</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/phisch84/spring-webmvc-utilities/issues</url>
    </issueManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- compiles against the Java 8 API, even if built with a newer JDK (same baseline as dao and domain-repository) -->
        <java.release.version>8</java.release.version>
        <maven.version>3.15.0</maven.version>
        <maven.jar-plugin.version>3.5.0</maven.jar-plugin.version>
        <maven.surfeire.version>3.5.5</maven.surfeire.version>
        <maven.javadoc-plugin.version>3.11.2</maven.javadoc-plugin.version>
        <versions-maven-plugin.version>2.25.1</versions-maven-plugin.version>
        <jacoco.version>0.8.12</jacoco.version>
        <junit.version>4.13.2</junit.version>
        <!-- latest Spring version compatible with Java 8 (same as dao and domain-repository) -->
        <spring.version>5.3.39</spring.version>
        <!-- Servlet 4.0 (javax.servlet) is the version Spring 5.3 is built for -->
        <javax.servlet.version>4.0.1</javax.servlet.version>
        <ddd.dao.version>4.1.0.RELEASE</ddd.dao.version>
        <ddd.domain-repository.version>3.0.0.RELEASE</ddd.domain-repository.version>
    </properties>

    <!--
    domain-repository3 and dao4 come from the GitHub Packages registries of their repositories. The ids are the ones the README
    tells users to configure; the GitHub workflows write a settings.xml with a server entry for each of them.
    -->
    <repositories>
        <repository>
            <id>github-domain-repository</id>
            <url>https://maven.pkg.github.com/phisch84/domain-repository</url>
        </repository>
        <repository>
            <id>github-dao</id>
            <url>https://maven.pkg.github.com/phisch84/dao</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- brings dao4 along -->
        <dependency>
            <groupId>com.schoste.ddd.domain</groupId>
            <artifactId>domain-repository3</artifactId>
            <version>${ddd.domain-repository.version}</version>
        </dependency>

        <!-- Servlet -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>${javax.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spring (DI/AOP/IoC Framework) dependencies -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- AbstractInMemoryDAO for the test fixtures -->
        <dependency>
            <groupId>com.schoste.ddd.infrastructure</groupId>
            <artifactId>dao4</artifactId>
            <version>${ddd.dao.version}</version>
            <classifier>tests</classifier>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Build and compiler plugin configuration -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.version}</version>
                    <configuration>
                        <release>${java.release.version}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>test-jar</goal>
                            </goals>
                        </execution>
                    </executions>
                    <!--
                    no Class-Path in the manifest: a library's dependencies are resolved by the application's build
                    (a Class-Path entry only makes javac -Xlint warn about a missing jar)
                    -->
                </plugin>

                <!-- Fixes "tests pass in Eclipse but fail in Maven Surefire -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surfeire.version}</version>
                    <configuration>
                        <reuseForks>false</reuseForks>
                        <forkCount>1</forkCount>
                    </configuration>
                </plugin>

                <!--
                Changes the version: mvn versions:set -DnewVersion=X.Y.Z.RELEASE -DgenerateBackupPoms=false
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
            Test coverage: a report (not a gate) in target/site/jacoco (index.html for people, jacoco.csv / jacoco.xml for tools),
            written by mvn verify
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Javadoc of the main and test classes; doclint fails the build on any warning -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc-plugin.version}</version>
                <configuration>
                    <release>${java.release.version}</release>
                    <quiet>true</quiet>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <doclint>all</doclint>
                        </configuration>
                    </execution>
                    <execution>
                        <id>attach-test-javadocs</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <doclint>all,-missing</doclint>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/phisch84/spring-webmvc-utilities</url>
        </repository>
    </distributionManagement>
</project>
