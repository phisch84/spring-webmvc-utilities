<beans 
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    
    xsi:schemaLocation="
    http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <bean id="ExampleClassAnnotation" class="com.schoste.ddd.application.v2.annotations.ExampleClassAnnotationPreHandler" scope="singleton">
        <property name="priority" value="0" />
    </bean>
    <bean id="ExampleMethodAnnotation" class="com.schoste.ddd.application.v2.annotations.ExampleMethodAnnotationPreHandler" scope="singleton">
        <property name="priority" value="1" />
    </bean>

    <bean id="ExampleRepository" class="com.schoste.ddd.application.v2.testfixtures.ExampleRepositoryImpl" scope="singleton" />
	<bean id="ExampleEntity" class="com.schoste.ddd.application.v2.testfixtures.ExampleEntity" scope="prototype" />
	<bean id="UnitOfWork" class="com.schoste.ddd.domain.v3.services.standard.UnitOfWorkImpl" scope="prototype" />
    <bean id="ExampleDO" class="com.schoste.ddd.application.v2.testfixtures.ExampleDO" scope="prototype" />
    <bean id="ExampleDAO" class="com.schoste.ddd.application.v2.testfixtures.ExampleDAOImpl" scope="singleton" />
	<bean id="MockedDataTransferObjectAConverter" class="com.schoste.ddd.application.v2.dtos.mocked.MockedDataTransferObjectAConverterImpl" scope="prototype" />
</beans>